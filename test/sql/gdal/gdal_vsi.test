50


# Disable external access
statement ok
set enable_external_access = false;

# Test read via VSI
statement error
SELECT COUNT(*) FROM st_read('/vsigzip/{WORKING_DIRECTORY}/test/data/amsterdam_roads_50.geojson.gz');
----
with VSI prefix: External access is disabled